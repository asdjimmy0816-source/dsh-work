{
  "name": "designer-desk",
  "version": "0.2.0",
  "description": "设计台 · 室内设计师个人工作台：项目管线 + 今日作战台 + 效果图工坊（ComfyUI）",
  "keywords": [
    "dsh-plugin",
    "designer",
    "workspace",
    "comfyui",
    "interior-design"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./api": {
      "types": "./lib/api.d.ts",
      "default": "./lib/api.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/api.js",
    "lib/api.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "gates": "node scripts/gates/run.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/build.mjs && node scripts/gates/run.mjs && node scripts/smoke.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.12",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
