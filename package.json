{
  "name": "designer-desk",
  "version": "0.1.0",
  "description": "设计台 · 室内设计师个人工作台：项目管线 + 今日作战台 + 效果图工坊（ComfyUI）",
  "keywords": ["dsh-plugin", "designer", "workspace", "comfyui", "interior-design"],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "gates": "node scripts/gates/run.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/build.mjs && node scripts/gates/run.mjs && node scripts/smoke.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.12",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
